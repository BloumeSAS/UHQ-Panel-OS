datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model UserProxy {
  id                 String   @id @default(uuid())
  name               String   @default("My Proxy")
  username           String   @unique
  password           String
  ipWhitelist        String?
  threadsLimit       Int      @default(100)
  totalBytesSent     BigInt   @default(0)
  totalBytesReceived BigInt   @default(0)
  trafficLimit       BigInt?
  usedGb             Float    @default(0)
  totalGb            Float    @default(0)
  countryFilter      String?
  isBlocked          Boolean  @default(false)
  stickySessionTtl   Int      @default(1800)
  createdAt          DateTime @default(now())
  // Liste privée d'upstreams (1 par ligne : [proto://][user:pass@]ip:port). Si
  // renseignée, le moteur fait courir CETTE liste au lieu du pool partagé.
  customProxies      String?
  // Panel : compte proxy assigné à au plus un utilisateur du panel (nullable = non assigné).
  ownerId            String?
  owner              PanelUser? @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  usageStats         ProxyUsage[]
  usageErrors        ProxyUsageError[]
  // Tags (comma-separated list of tag IDs or names stored as JSON array string)
  tags               String?
  // Bandwidth throttle in KB/s (null = unlimited)
  bandwidthLimit     Int?
  // Account expiry date (null = never expires)
  expiresAt          DateTime?
  // Pool de proxies utilisé par ce compte (null = pool partagé global)
  pool               String?
  // Port TCP dédié à CE compte (null = pas de port dédié, partage le port
  // global 990). Sur ce port, seules les identifiants de ce compte sont
  // acceptés (voie exclusive) — comportement sinon identique au port global.
  port               Int?     @unique
  // Domaine affiché dans les listes/connexions de CE compte (null = utilise
  // celui de sa pool, sinon `publicProxyHost`). Purement informatif (DNS) —
  // ne change rien au bind réseau du moteur.
  domain             String?
  // Domaines interdits pour CE compte (liste séparée par virgules, ex.
  // "exemple.com,autre.net") — bloque le domaine exact ET ses sous-domaines.
  // Vérifié dès la connexion (avant même de consommer un slot thread), pour
  // CONNECT (HTTPS, on connaît le host cible sans voir le contenu chiffré) et
  // HTTP en clair. Configurable en panel ET via l'API sub-user (legacy v1 +
  // self-service /me/proxies/:id).
  blockedDomains     String?

  @@index([ownerId])
}

// Lien de partage temporaire (accès non-authentifié) donnant les identifiants
// de connexion d'un UserProxy. Généré par un admin depuis le panel, révocable.
model ShareLink {
  id          String    @id @default(uuid())
  token       String    @unique
  userProxyId String
  createdById String?
  createdAt   DateTime  @default(now())
  // null = pas d'expiration (révocation manuelle uniquement)
  expiresAt   DateTime?
  revoked     Boolean   @default(false)

  @@index([userProxyId])
}

// Profil réutilisable pour la création rapide de comptes proxy (SubUsers).
model SubUserTemplate {
  id               String   @id @default(uuid())
  name             String
  threadsLimit     Int      @default(100)
  trafficLimitGb   Float?
  countryFilter    String?
  stickySessionTtl Int      @default(1800)
  bandwidthLimit   Int?
  createdAt        DateTime @default(now())
}

// Utilisateur du panel (login email/mot de passe). Distinct des comptes proxy (UserProxy).
model PanelUser {
  id                  String               @id @default(uuid())
  email               String               @unique
  passwordHash        String
  role                String               @default("USER") // "ADMIN" | "USER"
  isActive            Boolean              @default(true)
  createdAt           DateTime             @default(now())
  // Account expiration date (null = never expires)
  expiresAt           DateTime?
  // 2FA / TOTP
  totpEnabled         Boolean              @default(false)
  totpSecret          String?
  // Codes de récupération à usage unique (JSON array de hash bcrypt) —
  // générés à l'activation de la 2FA, consommés un par un si l'appareil TOTP
  // est perdu. Null tant que la 2FA n'a jamais été activée.
  totpRecoveryCodes   String?
  assignedProxies     UserProxy[]
  passwordResetTokens PasswordResetToken[]
  sessions            ActiveSession[]
  apiKeys             ApiKey[]
  notifications       Notification[]
}

// Token de réinitialisation de mot de passe (TTL 1 h, usage unique).
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      PanelUser @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Sessions actives du panel
model ActiveSession {
  id        String    @id @default(uuid())
  userId    String
  token     String    @unique
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  lastSeen  DateTime  @default(now())
  user      PanelUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Clés API multi-scopes avec expiry
model ApiKey {
  id        String    @id @default(uuid())
  userId    String
  name      String
  keyHash   String    @unique
  keyPrefix String    // first 8 chars for display
  scopes    String    @default("[]") // JSON array of scope strings
  expiresAt DateTime?
  lastUsed  DateTime?
  createdAt DateTime  @default(now())
  isActive  Boolean   @default(true)
  user      PanelUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// Journal d'audit — qui a fait quoi et quand
model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  userEmail  String?
  action     String   // e.g. "user.create", "proxy.delete", "settings.update"
  target     String?  // e.g. resource id or name
  details    String?  // JSON extra context
  ip         String?
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([userId])
}

// IP bannie de l'utilisation du moteur proxy (indépendant des comptes UserProxy
// individuels — coupe l'accès à TOUT compte connecté depuis cette IP). Vérifié
// en mémoire à chaque connexion entrante, avant même l'authentification (voir
// `ProxyServerService.handleClient`) — la connexion est fermée immédiatement
// avec une erreur HTTP 403, sans compter de thread ni tenter d'upstream.
model BannedIp {
  id        String    @id @default(cuid())
  ip        String    @unique
  reason    String?
  createdBy String?   // email de l'admin qui a posé le ban (traçabilité)
  expiresAt DateTime? // null = ban permanent
  createdAt DateTime  @default(now())

  @@index([expiresAt])
}

// Invitation par e-mail (inscription contrôlée)
model Invitation {
  id        String    @id @default(uuid())
  email     String
  token     String    @unique
  role      String    @default("USER")
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
}

// Notifications in-app (cloche + historique)
model Notification {
  id        String    @id @default(uuid())
  userId    String?   // null = global/admin broadcast
  type      String    // "info" | "warning" | "error" | "success"
  title     String
  message   String
  read      Boolean   @default(false)
  link      String?   // optional action link
  createdAt DateTime  @default(now())
  user      PanelUser? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
}

// Snapshot de la santé du pool (historique dans le temps)
model PoolHealthSnapshot {
  id           String   @id @default(cuid())
  total        Int
  working      Int
  dead         Int
  healthPct    Float
  createdAt    DateTime @default(now())

  @@index([createdAt])
}

// Snapshot périodique des compteurs CUMULATIFS de trafic (tous comptes
// confondus) — même principe que PoolHealthSnapshot, mais pour la bande
// passante. Un graphique de volume "par intervalle" se lit en faisant la
// différence entre deux points consécutifs, PAS la valeur brute (qui ne fait
// que croître). Sans cette table, seul le total du jour courant est visible
// (`/monitoring/live`) — aucun historique de trafic n'existait.
// Compteur global MONOTONE du trafic (ligne unique id="global") — incrémenté
// dans la même transaction que les compteurs de chaque compte, jamais remis à
// zéro ni diminué par un reset/une suppression de compte. Source des
// TrafficSnapshot (avant : somme des compteurs des comptes, qui baissait à
// chaque reset → intervalles entiers effacés du graphique).
model TrafficCounter {
  id            String @id @default("global")
  bytesSent     BigInt @default(0)
  bytesReceived BigInt @default(0)
  requests      BigInt @default(0)
}

model TrafficSnapshot {
  id                 String   @id @default(cuid())
  totalBytesSent     BigInt
  totalBytesReceived BigInt
  totalRequests      BigInt
  createdAt          DateTime @default(now())

  @@index([createdAt])
}

// Configuration éditable depuis le panel admin (clé/valeur). Fallback sur process.env.
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @default(now()) @updatedAt
}

// Métadonnées applicatives (ligne unique id="singleton") : pilote le setup wizard + version.
model AppMeta {
  id             String   @id @default("singleton")
  setupCompleted Boolean  @default(false)
  version        String   @default("2.0.0")
  updatedAt      DateTime @default(now()) @updatedAt
}

// Pool de catégories de proxies (Datacenter, Mobile, Résidentiel…).
// Le champ `pool` sur BackendProxy/UserProxy/ScraperSource stocke le name.
model ProxyPool {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  color       String?  @default("#6366f1")
  createdAt   DateTime @default(now())
  // Port TCP dédié (null = pas de port dédié, accessible via le port partagé +
  // filtre `pool` du compte). Sur ce port, toute connexion authentifiée utilise
  // CETTE pool, même si le compte a son propre `pool` par défaut.
  port        Int?     @unique
  // Domaine affiché dans les listes/connexions des comptes de cette pool sans
  // domaine propre (null = utilise `publicProxyHost`, Settings > Proxy public).
  // Purement informatif (DNS) — ne change rien au bind réseau du moteur.
  domain      String?
  // "Toujours en ligne" : les BackendProxy de cette pool ne sont jamais
  // testés par le checker (donc jamais marqués KO/morts) — forcés isWorking
  // à chaque cycle. Le scraper ne marque jamais rien mort de son côté (seul
  // le checker teste la connectivité réelle).
  alwaysOnline    Boolean @default(false)
  // "Checker actif" : si false, le cycle automatique du checker ignore
  // complètement les BackendProxy de cette pool (aucun test, statut figé tel
  // quel — contrairement à alwaysOnline qui force isWorking=true, ici on ne
  // touche à rien). Le bouton "Tester" manuel du panel continue de fonctionner
  // dans tous les cas (checkOne n'en tient pas compte).
  checkerEnabled  Boolean @default(true)
  // Pays simulés (codes ISO 2 lettres séparés par virgules, ex. "FR,DE,US")
  // AJOUTÉS aux vraies stats de /api/v1/common/category-stats — indépendant
  // de alwaysOnline (fonctionne même sans l'activer). Purement déclaratif
  // côté API legacy — ne crée ni ne déplace aucun BackendProxy réel.
  fakeCountries   String?
  // Sous-ensemble de fakeCountries (mêmes codes ISO) à toujours faire tirer
  // plus haut que les autres : [fakeIpCountMin,fakeIpCountMax] est découpé
  // en deux moitiés disjointes, ces pays tirent dans la moitié haute, les
  // autres dans la moitié basse — garantit prioritaire > non-prioritaire,
  // quel que soit le tirage (cf. splitRangeForPriority). Sans effet en
  // valeur fixe (min==max, pas de place pour départager).
  fakePriorityCountries String?
  // Bornes saisies par l'admin pour le nombre d'IPs simulé PAR PAYS (égales
  // = valeur fixe, différentes = tirage aléatoire — cf. fakeIpCountByCountry).
  fakeIpCountMin  Int?
  fakeIpCountMax  Int?
  // IP simulées PAR PAYS (clé = code ISO 2, valeur = tirage indépendant dans
  // [fakeIpCountMin,fakeIpCountMax] propre à CE pays, stable). Un pays n'est
  // (re)tiré que s'il est ajouté à fakeCountries ou que la plage change ; le
  // bouton "Régénérer" du panel force un nouveau tirage complet. Ignorée si
  // fakeIpRotateSeconds est actif (cf. ci-dessous).
  fakeIpCountByCountry Json @default("{}")
  // Mode rotatif : si renseigné, category-stats calcule l'IP de chaque pays
  // à la volée à partir de l'heure courante (fenêtre de N secondes) au lieu
  // de lire fakeIpCountByCountry — la valeur change donc automatiquement
  // toutes les N secondes, sans tâche planifiée ni écriture en base.
  // Null/0 = désactivé (comportement stable habituel).
  fakeIpRotateSeconds  Int?
  // Gabarit du username injecté dans le fallback résidentiel (SCRAPER_PROXY)
  // quand un pays est demandé — doit contenir {user} et {country}. Null =
  // format par défaut du moteur ("{user}__country__{country}"). Permet de
  // coller à la convention attendue par certains fournisseurs résidentiels
  // (ex. "{user}-country-{country}") sans toucher au code.
  fallbackCountryFormat String?
  // Anti-VPN : si activé, toute connexion dont l'IP cliente est identifiée
  // comme VPN/hébergeur (heuristique sur l'organisation ASN, base DB-IP
  // Lite — cf. VpnDetectionService) est refusée ET l'IP est bannie
  // immédiatement (même mécanisme que l'auto-ban proxyAuth, table
  // BannedIp). Vérifié après authentification, sur la pool EFFECTIVE de la
  // connexion (port dédié prioritaire sur `user.pool`, cf. handleClient).
  antiVpnEnabled Boolean @default(false)
}

model BackendProxy {
  id             String        @id @default(uuid())
  url            String        @unique
  protocol       String        @default("http")
  ip             String
  port           Int
  country        String?
  provider       String?
  lastChecked    DateTime      @default(now())
  isWorking      Boolean       @default(true)
  isBlacklisted  Boolean       @default(false)
  // Mort définitif (failCount >= deadProxyMaxRetries) : jamais re-testé, jamais
  // réactivé par un re-scrape, jamais supprimé automatiquement. Suppression =
  // action manuelle admin uniquement.
  archived       Boolean       @default(false)
  failCount      Int           @default(0)
  averageLatency Float?
  successCount   Int           @default(0)
  failureCount   Int           @default(0)
  // Comma-separated tags (e.g. "residential,fr,mobile")
  tags           String?
  // Pool de catégorie (null = pool par défaut, tous les utilisateurs y ont accès)
  pool           String?
  // Proxy "pays sélectionnable" : une seule passerelle sert plusieurs pays
  // selon le username envoyé (courant chez certains fournisseurs
  // résidentiels/datacenter). Si renseigné (ex. "{user}-country-{country}"
  // ou "dc-{country}"), ce proxy matche n'importe quel filtre pays — peu
  // importe `country` ci-dessus — et son username est réécrit à la volée
  // avec le pays demandé avant connexion. Placeholders : {user}, {country}
  // (minuscule), {COUNTRY} (majuscule). Différents proxies d'une même pool
  // peuvent avoir des gabarits différents (fournisseurs différents).
  countryFormat  String?
  targetBlocks   TargetBlock[]

  @@index([pool])
  @@index([isWorking])
  @@index([isBlacklisted])
  @@index([provider])
  @@index([archived])
}

model TargetBlock {
  id        String       @id @default(cuid())
  proxyId   String
  hostname  String
  blockedAt DateTime     @default(now())
  reason    String?
  proxy     BackendProxy @relation(fields: [proxyId], references: [id], onDelete: Cascade)

  @@unique([proxyId, hostname])
}

model ProxyUsage {
  id            String    @id @default(cuid())
  userProxyId   String
  hostname      String
  bytesSent     Float     @default(0)
  bytesReceived Float     @default(0)
  requests      Int       @default(0)
  date          DateTime  @default(now())
  userProxy     UserProxy @relation(fields: [userProxyId], references: [id], onDelete: Cascade)

  @@unique([userProxyId, hostname, date])
  // Requêtes par compte + plage de dates (Mes Proxies > usage) — la contrainte
  // unique ci-dessus a `hostname` entre les deux, donc inefficace seule pour
  // un `date >= X` sans filtrer aussi sur hostname.
  @@index([userProxyId, date])
  // Requêtes globales par plage de dates sans compte précis (monitoring/live).
  @@index([date])
}

// Compteur d'erreurs détectées sur le trafic HTTP en clair (sniff de chaîne
// sur le premier chunk reçu — cf. `ProxyServerService.onChunk`). Le moteur
// TCP est un tunnel bas niveau : pour l'HTTPS (l'essentiel du trafic), il ne
// voit jamais de code de statut (juste des octets chiffrés après le CONNECT).
// Ce compteur ne couvre donc QUE ce que le sniff HTTP en clair peut détecter
// (403, captcha, geo-block) — pas un vrai code de statut HTTP générique.
model ProxyUsageError {
  id          String    @id @default(cuid())
  userProxyId String
  hostname    String
  date        DateTime  @default(now())
  reason      String    // ex. "403 Forbidden", "Captcha detected", "Geo-blocked"
  count       Int       @default(1)
  userProxy   UserProxy @relation(fields: [userProxyId], references: [id], onDelete: Cascade)

  @@unique([userProxyId, hostname, date, reason])
  @@index([userProxyId, date])
  @@index([date])
}

// Source de scraping configurable depuis le panel admin. Le provider IA (Groq)
// est intégré ; toutes les autres sources sont définies ici (URL + regex).
model ScraperSource {
  id        String   @id @default(uuid())
  name      String
  url       String
  protocol  String   @default("http") // http | socks4 | socks5
  // Regex avec 2 groupes de capture (ip, port). Vide = regex ip:port par défaut.
  pattern   String?
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now())
  // Pool de destination pour les proxies scrapés (null = pool global)
  pool        String?
  // Suivi des échecs : incrémenté à chaque cycle sans proxies, remis à 0 au succès.
  // Après 5 échecs consécutifs, la source est auto-désactivée (enabled = false).
  failCount   Int       @default(0)
  lastError   String?
  lastSuccess DateTime?
}

// Addon externe : service tiers avec sa propre DB/front.
// Le panel charge le manifest depuis baseUrl/uhq-manifest.json
// et injecte les pages (iframe) + nav items décrits dedans.
model Addon {
  id            String    @id @default(uuid())
  // URL de base de l'addon (ex: https://shop.example.com)
  baseUrl       String    @unique
  // Manifest mis en cache (JSON brut)
  manifest      Json?
  // Dernière erreur lors du fetch du manifest
  manifestError String?
  fetchedAt     DateTime?
  enabled       Boolean   @default(true)
  createdAt     DateTime  @default(now())
  // Gestion des mises à jour
  // Version connue au moment de la connexion ou du dernier "apply update"
  lastVersion   String?
  // true = une nouvelle version a été détectée lors du dernier refresh
  hasUpdate     Boolean   @default(false)
}
